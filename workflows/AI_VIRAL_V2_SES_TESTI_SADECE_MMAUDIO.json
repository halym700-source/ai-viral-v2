      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Bu testte FastWan modeli ve yeni video uretimi YOK.\n// Daha once olusturulmus 20 saniyelik sessiz MP4 kullanilir.\nreturn [{json:{\n  video_url:'https://v3b.fal.media/files/b/0aaf5578/se2AI93_XaU_Odeb1S-yv_merged_video.mp4',\n  duration:20.17,\n  prompt:'Original cinematic instrumental ambience synchronized to the visible action: antique clock ticks, gentle mechanical gears, airy magical shimmer, deep mysterious atmosphere, a subtle rising pulse, soft whooshes, and a satisfying final resolution. Keep music and realistic sound effects balanced. No spoken words, singing, lyrics, recognizable melodies, or copyrighted songs.'\n}}];"
      }
    },
    {
      "id": "9f74a0f3-18bd-4890-95fd-0f2101c8aa03",
      "name": "03 MMAudio ses ekle - TEK POST",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
