        "url": "https://queue.fal.run/fal-ai/mmaudio-v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ video_url: $json.video_url, prompt: $json.prompt, negative_prompt:'speech, dialogue, singing, lyrics, distortion, excessive noise', duration:$json.duration, num_steps:25, cfg_strength:4.5 }) }}",
        "options": {
          "timeout": 120000
        }
      },
