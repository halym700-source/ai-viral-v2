        "jsCode": "const x = $input.first().json;\nconst videoUrl = x.video?.url || x.video_url || x.url;\nif (typeof videoUrl !== 'string' || !videoUrl.startsWith('https://')) {\n  throw new Error('MMAudio sesli MP4 URL dondurmedi. Otomasyonu yeniden calistirmadan once API yanitini inceleyin.');\n}\nreturn [{json:{status:'sesli_video_hazir',videoUrl,sourceVideoUrl:$('02 Hazir 20sn MP4 ve ses tarifi').first().json.video_url,notPublished:true,note:'Bu test YouTube yuklemesi ve FastWan video uretimi yapmaz.'}}];"
