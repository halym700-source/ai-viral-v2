      },
      "id": "rank-pexels-3",
      "name": "03 Find licensed Pexels footage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        730,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const topic=$('02 Ranking topic').first().json;\nconst videos=$input.first().json.videos || [];\nconst picks=[];\nfor (const v of videos) {\n  const sources=(v.video_files||[]).filter(f=>f.file_type==='video/mp4' && f.link && f.link.startsWith('https://'));\n  sources.sort((a,b)=>Math.abs((a.width||1080)-720)-Math.abs((b.width||1080)-720));\n  const best=sources.find(f=>(f.height||0)>(f.width||0) && (f.width||0)>=540) || sources.find(f=>(f.height||0)>(f.width||0));\n  if (!best || !v.url || (v.duration||0)<5 || picks.some(x=>x.url===best.link)) continue;\n  picks.push({rank:5-picks.length,url:best.link,label:'MOMENT '+(5-picks.length),source:v.url,license:'Pexels License',start:0});\n  if (picks.length===5) break;\n}\nif(picks.length<5) throw new Error('Insufficient licensed portrait footage; change search topic or Pexels query.');\nreturn [{json:{job_id:topic.job_id,manifest:{title:topic.title,intro:topic.intro,brand:topic.brand,clip_seconds:topic.clip_seconds,clips:picks}}}];"
      },
      "id": "rank-picks-4",
