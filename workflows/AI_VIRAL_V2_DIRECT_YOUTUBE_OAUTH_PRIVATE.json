        "jsCode": "let input=$input.all().map(o=>o.json); let rows=input.flatMap(o=>Array.isArray(o)?o:[o]);let err=rows.filter(o=>o.error);\nconst posts=rows.filter(x=>!x.error).map(x=>({platform:'tiktok',url:x.webVideoUrl||x.videoUrl||x.url||(x.id&&x.authorMeta?.name?'https://www.tiktok.com/@'+x.authorMeta.name+'/video/'+x.id:''),title:String(x.text||x.desc||x.title||'').slice(0,170),description:String(x.text||x.desc||'').slice(0,400),date:typeof x.createTime==='number'?new Date(x.createTime*1000).toISOString():(x.createTimeISO||x.createTime||x.createTimeUTC),views:Number(x.playCount??x.stats?.playCount??x.statistics?.playCount??0),likes:Number(x.diggCount??x.likes??0),comments:Number(x.commentCount??0),shares:Number(x.shareCount??0),duration:Number(x.videoMeta?.duration??x.video?.duration??0)})).filter(x=>x.url&&x.date);\nreturn [{json:{platform:'tiktok',posts,sourceCount:posts.length,errors:err.length}}];"
