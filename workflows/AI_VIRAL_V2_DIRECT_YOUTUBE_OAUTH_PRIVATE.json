        "jsCode": "let r=$input.all().map(x=>x.json).flatMap(x=>Array.isArray(x)?x:[x]);const errors=r.filter(x=>x.error).length;\nconst posts=r.filter(x=>!x.error).map(x=>({platform:'twitter',url:x.url||x.tweetUrl||(x.id&&x.author?.userName?'https://x.com/'+x.author.userName+'/status/'+x.id:''),title:String(x.fullText||x.text||'').slice(0,170),description:String(x.fullText||x.text||'').slice(0,400),date:x.createdAt||x.created_at||x.date,views:Number(x.viewCount??x.views??0),likes:Number(x.likeCount??x.favoriteCount??0),comments:Number(x.replyCount??0),shares:Number(x.retweetCount??0),duration:0,hasVideo:!!(x.isVideo||x.extendedEntities?.media?.some(m=>m.type==='video'||m.type==='animated_gif')||x.media?.some(m=>m.type==='video')||x.entities?.media?.some(m=>m.type==='video'))})).filter(x=>x.url&&x.date&&x.hasVideo);\nreturn [{json:{platform:'twitter',posts,sourceCount:posts.length,errors}}];"
