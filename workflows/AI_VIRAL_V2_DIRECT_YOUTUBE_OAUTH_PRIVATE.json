    {
      "id": "0cae6f30-e31d-4755-b10f-f7d333ef5544",
      "name": "14 Gercek trend puanla + top adaylar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3250,
        40
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Input is already de-duplicated by URL. Views/hour is a cumulative average, NOT measured view acceleration.\nconst sets=['07 YouTube normallestir','09 TikTok normallestir','11 Instagram normallestir','13 X normallestir'].map(n=>$(n).first().json);\nconst cutoff=Date.now()-7*86400000, now=Date.now(), seen=new Set(), all=[];\nfor(const s of sets){for(const p of s.posts||[]){let when=Date.parse(p.date);if(!Number.isFinite(when)||when<cutoff||when>now+60000||!p.url||seen.has(p.url))continue;seen.add(p.url);\nconst hours=Math.max(1,(now-when)/3600000),views=Math.max(0,+p.views||0),likes=Math.max(0,+p.likes||0),comments=Math.max(0,+p.comments||0),shares=Math.max(0,+p.shares||0);\nif(views===0&&likes===0)continue;\nconst velocity=views/hours;const eng=views>0?Math.min(.25,(likes+2*comments+3*shares)/views):0;\n// Comparable only as a rough ranking heuristic. X posts with unavailable views get a lower-confidence penalty.\nconst confidence=views>0?1:.35;\nconst score=Math.round(100*(Math.log10(velocity+1)*.7+Math.log10(likes/hours+1)*.20+Math.min(10,eng*20)*.10)*confidence);\nall.push({...p,views,likes,comments,shares,ageHours:Math.round(hours),viewsPerHour:Math.round(velocity),engagementRate:Number(eng.toFixed(4)),score,confidence:views>0?'medium':'low'});\n}}\nall.sort((a,b)=>b.score-a.score);if(!all.length)throw new Error('Son 7 gun icin GERCEK ve tarihli video verisi gelmedi. Tahmini verilerle video uretimi durduruldu.');\nconst byPlatform=Object.fromEntries(sets.map(s=>[s.platform,{items:s.sourceCount,errors:s.errors||0}]));\nconst chosen=[...all.slice(0,13)];const already=new Set(chosen.map(x=>x.url));\nfor(const platform of ['youtube','tiktok','instagram','twitter']){const best=all.filter(v=>v.platform===platform).slice(0,4);for(const item of best)if(!already.has(item.url)){already.add(item.url);chosen.push(item);}}\nchosen.sort((a,b)=>b.score-a.score);\nconst mode=$('03 YouTube arama konulari').first().json.mode;\nreturn [{json:{mode,platforms:byPlatform,candidates:chosen.slice(0,29),totalCandidates:all.length,rankingMethod:'Approx. views/age + engagements; missing view metrics penalized; not a prediction guarantee',createdAt:new Date().toISOString()}}];"
      }
