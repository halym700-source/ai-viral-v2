        "mode": "runOnceForAllItems",
        "jsCode": "const raw=$input.first().json?.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join('')||'';\nif(!raw.trim())throw new Error('Gemini bos dondu; modeli veya kotayi kontrol edin');\nlet o;try{o=JSON.parse(raw.replace(/^```json\\s*/i,'').replace(/```$/,'').trim())}catch(e){throw new Error('Gemini JSON gecersiz: '+raw.slice(0,240))}\nconst c=$('14 Gercek trend puanla + top adaylar').first().json.candidates;const urls=new Set(c.map(x=>x.url));\nif(!o.concept||!o.videoPrompt||String(o.videoPrompt).length<70)throw new Error('Gemini video fikri eksik');\nif(!urls.has(o.selectedSourceUrl))throw new Error('Gemini kaynak URL uydurdu veya girdi disi secim yapti');\no.sourceUrls=(Array.isArray(o.sourceUrls)?o.sourceUrls:[]).filter(u=>urls.has(u)).slice(0,3);\no.youtubeTitle=String(o.youtubeTitle||o.concept).slice(0,88);o.youtubeDescription=String(o.youtubeDescription||'AI-generated animation.').slice(0,1200);\no.hashtags=(Array.isArray(o.hashtags)?o.hashtags:[]).slice(0,8).map(x=>String(x).replace(/[^a-zA-Z0-9_]/g,'').toLowerCase()).filter(Boolean);\no.videoPrompt=String(o.videoPrompt).slice(0,2200);\nreturn [{json:o}];"
      }
