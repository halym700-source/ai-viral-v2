      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function dur(s){let a=String(s||'').match(/PT(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+)S)?/);return a?(+a[1]||0)*3600+(+a[2]||0)*60+(+a[3]||0):9999;}\nconst now=Date.now(); const items=$input.first().json.items||[];\nconst posts=items.map(v=>({platform:'youtube',url:v.id?'https://www.youtube.com/watch?v='+v.id:'',title:String(v.snippet?.title||'').slice(0,160),description:String(v.snippet?.description||'').slice(0,400),date:v.snippet?.publishedAt,views:Number(v.statistics?.viewCount||0),likes:Number(v.statistics?.likeCount||0),comments:Number(v.statistics?.commentCount||0),shares:0,duration:dur(v.contentDetails?.duration)})).filter(x=>x.url&&x.views>0&&x.duration<=180&&Date.parse(x.date)>now-7*86400000);\nreturn [{json:{platform:'youtube',posts,sourceCount:posts.length}}];"
      }
    },
